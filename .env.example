# URL de connexion à la base de données PostgreSQL (fournie par Supabase).
# Exemple : postgresql://postgres:VOTRE_MOT_DE_PASSE@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Clé secrète utilisée pour signer les sessions de connexion.
# Générez une valeur aléatoire longue, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port du serveur backend (Render le fournit automatiquement, sinon 3000 par défaut).
PORT=3000
